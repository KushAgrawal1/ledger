# Copy this to .env and fill in real values
# Generate SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(32))"

DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/ledger
SECRET_KEY=generate-with-python3-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSFERS_TOPIC=ledger.transfers
